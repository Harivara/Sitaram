include <bits/stdc++.h>
using namespace std;

long long minCost(vector<vector<int>>& arr) { int n = arr.size();

const long long INF = 1e18;

long long keep = 0;
long long swap = (arr[0][2] == -1) ? INF : arr[0][2];

for (int i = 1; i < n; i++) {
    long long newKeep = INF;
    long long newSwap = INF;

    int a = arr[i - 1][0];
    int b = arr[i - 1][1];

    int x = arr[i][0];
    int y = arr[i][1];

    int cost = arr[i][2];

    // Case 1: Both arrays increase without crossing
    if (a < x && b < y) {
        newKeep = min(newKeep, keep);

        if (cost != -1) {
            newSwap = min(newSwap, swap + cost);
        }
    }

    // Case 2: Both arrays increase by swapping
    // one of the two adjacent positions
    if (a < y && b < x) {
        if (cost != -1) {
            newSwap = min(newSwap, keep + cost);
        }

        newKeep = min(newKeep, swap);
    }

    keep = newKeep;
    swap = newSwap;
}

long long ans = min(keep, swap);

return ans == INF ? -1 : ans;
}

int main() { vector<vector<int>> arr = { {1, 2, 3}, {4, 5, 6}, {7, 4, 9}, {10, 11, 12} };

cout << minCost(arr);

return 0;