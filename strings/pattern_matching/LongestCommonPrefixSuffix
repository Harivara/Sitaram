https://leetcode.com/problems/longest-happy-prefix/

class Solution {
public:
void filllps(vector<int>&lps,string s){
    int len=0;
    int i=1;
    lps[0]=0;

    while(i<s.length()){
        if(s[i]==s[len]){
            len++;
            lps[i]=len;
            i++;
        }
        else{
            if(len==0){
                i++;
            }
            else{
                len=lps[len-1];
            }
        }
    }

}
    string longestPrefix(string s) {
        int n=s.length();
        vector<int>lps(n,0);
        filllps(lps,s);
        return s.substr(0,lps[n-1]);

    }
};